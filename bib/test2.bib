@article{ WOS:000671590200005,
Author = {Adams, Corey and Carleo, Giuseppe and Lovato, Alessandro and Rocco,
   Noemi},
Title = {Variational Monte Carlo Calculations of $A \leq 4$ Nuclei with an Artificial
   Neural-Network Correlator Ansatz},
Journal = {PHYSICAL REVIEW LETTERS},
Year = {2021},
Volume = {127},
Number = {2},
Month = {JUL 7},
Abstract = {The complexity of many-body quantum wave functions is a central aspect
   of several fields of physics and chemistry where nonperturbative
   interactions are prominent. Artificial neural networks (ANNs) have
   proven to be a flexible tool to approximate quantum many-body states in
   condensed matter and chemistry problems. In this work we introduce a
   neural-network quantum state ansatz to model the ground-state wave
   function of light nuclei, and approximately solve the nuclear many-body
   Schrodinger equation. Using efficient stochastic sampling and
   optimization schemes, our approach extends pioneering applications of
   ANNs in the field, which present exponentially scaling algorithmic
   complexity. We compute the binding energies and point-nucleon densities
   of A <= 4 nuclei as emerging from a leading-order pionless effective
   field theory Hamiltonian. We successfully benchmark the ANN wave
   function against more conventional parametrizations based on two- and
   three-body Jastrow functions, and virtually exact Green's function Monte
   Carlo results.},
