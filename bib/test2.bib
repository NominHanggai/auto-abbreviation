@article{ WOS:000538758100001,
Author = {Stokes, James and Izaac, Josh and Killoran, Nathan and Carleo, Giuseppe},
Title = {Quantum Natural Gradient},
Journal = {QUANTUM},
Year = {2020},
Volume = {4},
Month = {MAY 14},
Abstract = {A quantum generalization of Natural Gradient Descent is presented as
   part of a general-purpose optimization framework for variational quantum
   circuits. The optimization dynamics is interpreted as moving in the
   steepest descent direction with respect to the Quantum Information
   Geometry, corresponding to the real part of the Quantum Geometric Tensor
   (QGT), also known as the Fubini-Study metric tensor. An efficient
   algorithm is presented for computing a block-diagonal approximation to
   the Fubini-Study metric tensor for parametrized quantum circuits, which
   may be of independent interest.},
