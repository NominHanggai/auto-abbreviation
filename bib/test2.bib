@article{ WOS:000327714900008,
Author = {Neuscamman, Eric},
Title = {The Jastrow antisymmetric geminal power in Hilbert space: Theory,
   benchmarking, and application to a novel transition state},
Journal = {JOURNAL OF CHEMICAL PHYSICS},
Year = {2013},
Volume = {139},
Number = {19},
Month = {NOV 21},
Abstract = {The Jastrow-modified antisymmetric geminal power (JAGP) ansatz in
   Hilbert space successfully overcomes two key failings of other pairing
   theories, namely, a lack of inter-pair correlations and a lack of
   multiple resonance structures, while maintaining a polynomially scaling
   cost, variational energies, and size consistency. Here, we present
   efficient quantum Monte Carlo algorithms that evaluate and optimize the
   JAGP energy for a cost that scales as the fifth power of the system
   size. We demonstrate the JAGP's ability to describe both static and
   dynamic correlation by applying it to bond stretching in H2O, C-2, and
   N-2 as well as to a novel, multi-reference transition state of ethene.
   JAGP's accuracy in these systems outperforms even the most sophisticated
   single-reference methods and approaches that of exponentially scaling
   active space methods. (C) 2013 AIP Publishing LLC.},
