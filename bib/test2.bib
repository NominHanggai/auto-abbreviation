@article{ WOS:000073632900050,
Author = {Sorella, S},
Title = {Green function Monte Carlo with stochastic reconfiguration},
Journal = {PHYSICAL REVIEW LETTERS},
Year = {1998},
Volume = {80},
Number = {20},
Pages = {4558-4561},
Month = {MAY 18},
Abstract = {A new method for the stabilization of the sign problem in the Green
   function Monte Carlo technique is proposed. The method is devised for
   real lattice Hamiltonians and is based on an iterative ``stochastic
   reconfiguration{''} scheme which introduces some bias but allows a
   stable simulation with constant sign. The systematic reduction of this
   bias is possible in principle. The method is applied to the frustrated
   J(1) - J(2) Heisenberg model, and tested against exact diagonalization
   data. Evidence of a finite spin gap for J(2)/J(1) > similar to 0.4 is
   found in the thermodynamic limit.},
