@article{ WOS:000447730600015,
Author = {Choo, Kenny and Carleo, Giuseppe and Regnault, Nicolas and Neupert,
   Titus},
Title = {Symmetries and Many-Body Excitations with Neural-Network Quantum States},
Journal = {PHYSICAL REVIEW LETTERS},
Year = {2018},
Volume = {121},
Number = {16},
Month = {OCT 19},
Abstract = {Artificial neural networks have been recently introduced as a general
   ansatz to represent many-body wave functions. In conjunction with
   variational Monte Carlo calculations, this ansatz has been applied to
   find Hamiltonian ground states and their energies. Here, we provide
   extensions of this method to study excited states, a central task in
   several many-body quantum calculations. First, we give a prescription
   that allows us to target eigenstates of a (nonlocal) symmetry of the
   Hamiltonian. Second, we give an algorithm to compute low-lying excited
   states without symmetries. We demonstrate our approach with both
   restricted Boltzmann machines and feed-forward neural networks. Results
   are shown for the one-dimensional spin1/2 Heisenberg model, and for the
   one-dimensional Bose-Hubbard model. When comparing to exact results, we
   obtain good agreement for a large range of excited-states energies.
   Interestingly, we find that deep networks typically outperform shallow
   architectures for high-energy states.},
