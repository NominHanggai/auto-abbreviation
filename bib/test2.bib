@article{ WOS:000926104800018,
Author = {Moreno, Javier Robledo and Carleo, Giuseppe and Georges, Antoine and
   Stokes, James},
Title = {Fermionic wave functions from neural-network constrained hidden states},
Journal = {PROCEEDINGS OF THE NATIONAL ACADEMY OF SCIENCES OF THE UNITED STATES OF
   AMERICA},
Year = {2022},
Volume = {119},
Number = {32},
Month = {AUG 9},
Abstract = {We introduce a systematically improvable family of variational wave
   functions for the simulation of strongly correlated fermionic systems.
   This family consists of Slater determinants in an augmented Hilbert
   space involving ``hidden{''} additional fermionic degrees of freedom.
   These determinants are projected onto the physical Hilbert space through
   a constraint that is optimized, together with the single-particle
   orbitals, using a neural network parameterization. This construction
   draws inspiration from the success of hidden-particle representations
   but overcomes the limitations associated with the mean-field treatment
   of the constraint often used in this context. Our construction provides
   an extremely expressive family of wave functions, which is proved to be
   universal. We apply this construction to the ground-state properties of
   the Hubbard model on the square lattice, achieving levels of accuracy
   that are competitive with those of state-of-the-art variational methods.},
