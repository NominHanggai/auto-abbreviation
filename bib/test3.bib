	keywords = {Electrodynamics; Elementary particle sources; Light sources; Nanocrystals; Optical correlation; Particle beams; Photons; Quantum chemistry; Semiconductor quantum wells; Stark effect; Wave functions; Cavity Quantum Electrodynamics; Device simulations; Quantum confined stark effect; Quantum-classical; Quantum-dot-based single-photon sources; Second-order correlation functions; Semiconductor device equations; Single-photon source; Semiconductor quantum dots},
