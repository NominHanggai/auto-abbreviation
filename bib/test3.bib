	title = {Non-equilibrium spin-boson model: Counting statistics and the heat exchange fluctuation theorem},
	year = {2011},
	journal = {Journal of Chemical Physics},
	volume = {135},
	number = {16},
	doi = {10.1063/1.3655674},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-80555129454&doi=10.1063%2f1.3655674&partnerID=40&md5=ac9bd096ccd552617ebd27ea51306a90},
	affiliations = {Chemical Physics Theory Group, Department of Chemistry, University of Toronto, Toronto, ON M5S 3H6, 80 Saint George St., Canada},
	abstract = {We focus on the non-equilibrium two-bath spin-boson model, a toy model for examining quantum thermal transport in many-body open systems. Describing the dynamics within the noninteracting-blip approximation equations, applicable, e.g., in the strong system-bath coupling limit and/or at high temperatures, we derive expressions for the cumulant generating function in both the Markovian and non-Markovian limits by energy-resolving the quantum master equation of the subsystem. For a Markovian bath, we readily demonstrate the validity of a steady-state heat exchange fluctuation theorem. In the non-Markovian limit a "weaker "symmetry relation generally holds, a general outcome of microreversibility. We discuss the reduction of this symmetry relation to the universal steady-state fluctuation theorem. Using the cumulant generating function, an analytic expression for the heat current is obtained. Our results establish the validity of the steady-state heat exchange fluctuation theorem in quantum systems with strong system-bath interactions. From the practical point of view, this study provides tools for exploring transport characteristics of the two-bath spin-boson model, a prototype for a nonlinear thermal conductor. © 2011 American Institute of Physics.},
	keywords = {Heat exchangers; Quantum chemistry; Quantum electronics; Quantum optics; Analytic expressions; Approximation equations; Counting statistics; Cumulants; Fluctuation theorems; Generating functions; Heat currents; Heat exchange; High temperature; Many-body; Markovian; Non equilibrium; Non-Markovian; Quantum master equations; Quantum system; Spin boson models; Steady-state fluctuation; Symmetry relations; System-bath coupling; Thermal conductors; Thermal transport; Toy models; Transport characteristics; Bosons},
	correspondence_address = {D. Segal; Chemical Physics Theory Group, Department of Chemistry, University of Toronto, Toronto, ON M5S 3H6, 80 Saint George St., Canada; email: dsegal@chem.utoronto.ca},
	issn = {00219606},
	coden = {JCPSA},
	language = {English},
	abbrev_source_title = {J Chem Phys},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
