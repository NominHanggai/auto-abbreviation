	affiliations = {Max Planck Institute for the Structure and Dynamics of Matter, Center for Free-Electron Laser Science, Hamburg, 22761, Germany; Center for Computational Quantum Physics, Flatiron Institute, New York, 10010, NY, United States; Center for Computational Sciences, University of Tsukuba, Tsukuba, 305-8577, Japan},
