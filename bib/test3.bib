	affiliations = {Department of Theoretical Physics, Faculty of Physics, Vilnius University, LT-10222 Vilnius, Sauletekio Avenue 9, Lithuania; Center for Physical Sciences and Technology, Institute of Physics, LT-02300 Vilnius, Savanoriu Avenue 231, Lithuania; State Key Laboratory of Supramolecular Structure and Materials, Jilin University, Changchun 130012, 2699 Qianjin Street, China; Faculty of Mathematics and Physics, Charles University in Prague, CZ-121 16 Prague 2, Ke Karlovu 5, Czech Republic},
