@ARTICLE{Yasini2023,
	author = {Yasini, Soheil and Shaterzadeh-Yazdi, Zahra and Mohammad Taheri, Mahmoud},
	title = {Characterization and Coherent Control of Spin Qubits with Modulated Electron Beam and Resonator},
	year = {2023},
