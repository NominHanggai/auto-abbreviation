	doi = {10.1103/PhysRevB.104.155407},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85116805357&doi=10.1103%2fPhysRevB.104.155407&partnerID=40&md5=2e401bc81c1519aaf1cf212ad918aa0d},
