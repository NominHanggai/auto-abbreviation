	year = {2024},
	journal = {Physical Review Applied},
	volume = {22},
	number = {1},
	doi = {10.1103/PhysRevApplied.22.014028},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85198604656&doi=10.1103%2fPhysRevApplied.22.014028&partnerID=40&md5=c945a3565b343e9fd361dd506e5ea558},
