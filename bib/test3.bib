	source = {Scopus},
	note = {Cited by: 16; All Open Access, Green Open Access, Hybrid Gold Open Access}
}

@ARTICLE{Gaspard2022,
	author = {Gaspard, David},
	title = {Quantum master equations for a fast particle in a gas},
	year = {2022},
	journal = {Physical Review A},
