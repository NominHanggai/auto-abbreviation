}

@ARTICLE{Dugar2022,
	author = {Dugar, Palak and Chien, Chih-Chun},
	title = {Geometry-based circulation of local thermal current in quantum harmonic and Bose-Hubbard systems},
	year = {2022},
	journal = {Physical Review E},
	volume = {105},
	number = {6},
	doi = {10.1103/PhysRevE.105.064111},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85133368951&doi=10.1103%2fPhysRevE.105.064111&partnerID=40&md5=3604b8245e4a237b5098c8a3b76954f6},
	affiliations = {Department of Physics, University of California, Merced, 95343, CA, United States},
	abstract = {A geometry-based mechanism for generating steady-state internal circulation of local thermal currents is demonstrated by harmonically coupled quantum oscillators formulated by the Redfield quantum master equation (RQME) and the Bose-Hubbard model (BHM) of phonons formulated by the Lindblad quantum master equation (LQME) using the simple multipath geometry of a triangle. Driven by two reservoirs at different temperatures, both systems can exhibit an atypical local thermal current flowing against the total current. However, the total thermal current behaves normally. While the RQME of harmonically coupled quantum oscillators allows an analytical solution, the LQME of the interacting BHM can be solved numerically. The emergence of the geometry-based circulation in both systems demonstrates the ubiquity and robustness of the mechanism. In the high-temperature limit, the results agree with the classical results, confirming the generality of the geometric-based circulation across the quantum and classical boundary. The geometry-based circulation also emerges from a quantum Langevin equation calculation. Possible experimental implications and applications are briefly discussed. © 2022 American Physical Society.},
	keywords = {Differential equations; Harmonic analysis; Hubbard model; Quantum theory; Temperature; Bose Hubbard model; Hubbard systems; Internal circulations; Lindblad; Multipath; Quantum master equations; Quantum oscillators; Simple++; Steady state; Thermal current; Geometry},
	publisher = {American Physical Society},
	issn = {24700045},
	pmid = {35854609},
	language = {English},
	abbrev_source_title = {Phys. Rev. E},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 6; All Open Access, Green Open Access}
}

@ARTICLE{Bruschi202227645,
