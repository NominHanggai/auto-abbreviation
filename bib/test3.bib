@ARTICLE{Donvil2023,
	author = {Donvil, Brecht I.C. and Muratore-Ginanneschi, Paolo},
	title = {On the Unraveling of Open Quantum Dynamics},
	year = {2023},
	journal = {Open Systems and Information Dynamics},
	volume = {30},
	number = {3},
	doi = {10.1142/S1230161223500154},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85176787502&doi=10.1142%2fS1230161223500154&partnerID=40&md5=0b27d5ef6f566af3217e9fef6fe50f9c},
	affiliations = {Institute for Complex Quantum Systems and IQST, Ulm University, Albert-Einstein-Allee 11, Ulm, D-89069, Germany; University of Helsinki, Department of Mathematics and Statistics, P.O. Box 68, Helsinki, FIN-00014, Finland},
	abstract = {It is well known that the state operator of an open quantum system can be generically represented as the solution of a time-local equation — a quantum master equation. Unraveling in quantum trajectories offers a picture of open system dynamics dual to solving master equations. In the unraveling picture, physical indicators are computed as Monte Carlo averages over a stochastic process valued in the Hilbert space of the system. This approach is particularly adapted to simulate systems in large Hilbert spaces. We show that the dynamics of an open quantum system generically admits an unraveling in the Hilbert space of the system described by a Markov process generated by ordinary stochastic differential equations for which rigorous concentration estimates are available. The unraveling can be equivalently formulated in terms of norm-preserving state vectors or in terms of linear “ostensible” processes trace preserving only on average. We illustrate the results in the case of a two level system in a simple boson environment. Next, we derive the state-of-the-art form of the Diósi-Gisin-Strunz Gaussian random ostensible state equation in the context of a model problem. This equation provides an exact unraveling of open systems in Gaussian environments. We compare and contrast the two unravelings and their potential for applications to quantum error mitigation. © 2023 World Scientific Publishing Co. Pte Ltd. All rights reserved.},
	author_keywords = {continuous quantum measurement; master equation; non-Markovian quantum master equation; Open quantum systems; quantum error mitigation; quantum trajectories; stochastic Schrödinger equation; unravelling},
	publisher = {World Scientific},
	issn = {12301612},
	language = {English},
	abbrev_source_title = {Open Syst. Inf. Dyn.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3; All Open Access, Green Open Access}
}

