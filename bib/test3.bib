	language = {English},
	abbrev_source_title = {Phys. Rev. A},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Bashir2024,
	author = {Bashir, Saima and Lone, Muzaffar Qadir and Ganai, Prince A},
	title = {Decoherence Dynamics in a Polaron System with Collective Dephasing},
	year = {2024},
	journal = {International Journal of Theoretical Physics},
	volume = {63},
	number = {12},
	doi = {10.1007/s10773-024-05843-0},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85213051235&doi=10.1007%2fs10773-024-05843-0&partnerID=40&md5=4d2d8d0587f767c0826da40261491acb},
	affiliations = {Department of Physics, National Institute of Technology, Srinagar, 190006, India; Quantum Dynamics Lab, Department of Physics, University of Kashmir, Srinagar, 190006, India},
	abstract = {Within quantum information frameworks, managing decoherence stands as a pivotal task. The present work delves into decoherence dynamics of a dressed qubit, represented by a spinless fermion hopping between two lattice sites that are strongly coupled to a collective bosonic bath. To simplify calculations under strong coupling, we adopt the Lang-Firsov transformation, effectively minimizing system-bath interactions. Within the polaron perspective using Ohmic bath spectral density with a Gaussian cutoff, we identify a fundamental timescale s (equivalently a length scale l), dictating coherence decay. Utilizing a quantum master equation in the energy eigen basis while maintaining fixed particle number, we demonstrate that coherence persists for small s values but diminishes for larger ones. Additionally, we explore the utilization of π-pulses to manipulate decoherence within the system. © The Author(s), under exclusive licence to Springer Science+Business Media, LLC, part of Springer Nature 2024.},
	author_keywords = {Control; Decoherence; Dephasing; Master equation; Polaron transformation},
	correspondence_address = {M.Q. Lone; Quantum Dynamics Lab, Department of Physics, University of Kashmir, Srinagar, 190006, India; email: lone.muzaffar@uok.edu.in},
