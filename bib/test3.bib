	doi = {10.1103/PhysRevB.93.125122},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84960930105&doi=10.1103%2fPhysRevB.93.125122&partnerID=40&md5=4d44365efa888bdeaab9109f95f067b1},
