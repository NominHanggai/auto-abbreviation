	language = {English},
	abbrev_source_title = {Int. J. Theor. Phys.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Becker2022,
	author = {Becker, Tobias and Schnell, Alexander and Thingna, Juzar},
	title = {Canonically Consistent Quantum Master Equation},
	year = {2022},
	journal = {Physical Review Letters},
	volume = {129},
	number = {20},
	doi = {10.1103/PhysRevLett.129.200403},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85141914034&doi=10.1103%2fPhysRevLett.129.200403&partnerID=40&md5=3502543d00a092176150e33ab631926a},
	affiliations = {Institut für Theoretische Physik, Technische Universität Berlin, Hardenbergstr. 36, Berlin, D-10623, Germany; Department of Physics and Applied Physics, University of Massachusetts, Lowell, 01854, MA, United States; Center for Theoretical Physics of Complex Systems, Institute for Basic Science (IBS), Daejeon, 34126, South Korea},
	abstract = {We put forth a new class of quantum master equations that correctly reproduce the asymptotic state of an open quantum system beyond the infinitesimally weak system-bath coupling limit. Our method is based on incorporating the knowledge of the reduced steady state into its dynamics. The correction not only steers the reduced system toward a correct steady state but also improves the accuracy of the dynamics, thereby refining the archetypal Born-Markov weak-coupling second-order master equations. In case of equilibrium, we use the exact mean-force Gibbs state to correct the Redfield quantum master equation. By benchmarking it with the exact solution of the damped harmonic oscillator, we show that our method also helps correct the long-standing issue of positivity violation, albeit without complete positivity. Our method of a canonically consistent quantum master equation opens a new perspective in the theory of open quantum systems leading to a reduced density matrix accurate beyond the commonly used Redfield and Lindblad equations, while retaining the same conceptual and numerical complexity.  © 2022 American Physical Society.},
	keywords = {Quantum optics; Systems analysis; Asymptotic state; Coupling limits; Master equations; Open quantum systems; Quantum master equations; Reduced systems; Second orders; Steady state; System-bath coupling; Weak couplings; Numerical methods},
	publisher = {American Physical Society},
	issn = {00319007},
	coden = {PRLTA},
	pmid = {36461992},
	language = {English},
	abbrev_source_title = {Phys Rev Lett},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 22; All Open Access, Green Open Access}
}

