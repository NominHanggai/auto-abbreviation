@ARTICLE{Wang2022,
	author = {Wang, Fei-Yu and Lu, Jin-Cheng and Wang, Zi and Duan, Li-Wei and Wang, Chen and Ren, Jie},
	title = {Nonequilibrium thermal transport in the two-mode qubit-resonator system},
	year = {2022},
	journal = {Frontiers in Physics},
	volume = {10},
	doi = {10.3389/fphy.2022.964858},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85137874887&doi=10.3389%2ffphy.2022.964858&partnerID=40&md5=ed112b7eea40b1afd5216d91e0344c1e},
	affiliations = {Department of Physics, Zhejiang Normal University, ZJ, Jinhua, China; Center for Phononics and Thermal Energy Science, China-EU, Joint Laboratory on Nanophononics, Shanghai Key Laboratory of Special Artificial Microstructure Materials and Technology, School of Physics Science and Engineering, Tongji University, Shanghai, China},
	abstract = {Nonequilibrium thermal transport in circuit quantum electrodynamics emerges as one interdisciplinary field, due to the tremendous advance of quantum technology. Here, we study steady-state heat flow in a two-mode qubit-resonator model under the influence of both the qubit-resonator and resonator-resonator interactions. The heat current is suppressed and enhanced by tuning up resonator-resonator interaction strength with given weak and strong qubit-resonator couplings respectively, which is cooperative contributed by the eigen-mode of coupled resonators and qubit-photon scattering. Negative differential thermal conductance and significant thermal rectification are exhibited at weak qubit-resonator coupling, which are dominated by cycle transition processes. Moreover, the heat flow through the resonator decoupled from the qubit can be dramatically enhanced via the resonator-resonator interaction, which is attributed by the generation of eigen-mode channels of resonators. Copyright © 2022 Wang, Lu, Wang, Duan, Wang and Ren.},
	author_keywords = {circuit quantum electrodynamics; cycle transition process; nonequilibrium thermal transport; quantum master equation; qubit-resonator interaction},
	keywords = {Electrodynamics; Heat transfer; Quantum chemistry; Quantum theory; Qubits; Timing circuits; Circuit quantum electrodynamic; Cycle transition process; Non equilibrium; Nonequilibrium thermal transport; Quantum electrodynamics; Quantum master equations; Qubit-resonator interaction; Resonator coupling; Thermal transport; Transition process; Resonators},
	correspondence_address = {C. Wang; Department of Physics, Zhejiang Normal University, Jinhua, ZJ, China; email: wangchen@zjnu.cn; J. Ren; Center for Phononics and Thermal Energy Science, China-EU, Joint Laboratory on Nanophononics, Shanghai Key Laboratory of Special Artificial Microstructure Materials and Technology, School of Physics Science and Engineering, Tongji University, Shanghai, China; email: Xonics@tongji.edu.cn},
	publisher = {Frontiers Media SA},
	issn = {2296424X},
	language = {English},
	abbrev_source_title = {Front. Phys.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3; All Open Access, Gold Open Access}
}

