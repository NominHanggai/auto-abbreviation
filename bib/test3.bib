	publisher = {American Physical Society},
	issn = {24699926},
	language = {English},
	abbrev_source_title = {Phys. Rev. A},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2; All Open Access, Green Open Access}
}

