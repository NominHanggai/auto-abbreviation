	affiliations = {Institut für Theoretische Physik, Center for Quantum Science, Universität Tübingen, Auf der Morgenstelle 14, Tübingen, 72076, Germany; Max Planck Institute for Intelligent Systems, Max-Planck-Ring 4, Tübingen, 72076, Germany; School of Physics and Astronomy, University of Nottingham, Nottingham, NG7 2RD, United Kingdom; Centre for the Mathematics and Theoretical Physics of Quantum Non-Equilibrium Systems, University of Nottingham, Nottingham, NG7 2RD, United Kingdom},
	abstract = {Full information about a many-body quantum system is usually out-of-reach due to the exponential growth - with the size of the system - of the number of parameters needed to encode its state. Nonetheless, in order to understand the complex phenomenology that can be observed in these systems, it is often sufficient to consider dynamical or stationary properties of local observables or, at most, of few-body correlation functions. These quantities are typically studied by singling out a specific subsystem of interest and regarding the remainder of the many-body system as an effective bath. In the simplest scenario, the subsystem dynamics, which is in fact an open quantum dynamics, can be approximated through Markovian quantum master equations. Here, we formulate the problem of finding the generator of the subsystem dynamics as a variational problem, which we solve using the standard toolbox of machine learning for optimization. This dynamical or 'Lindblad' generator provides the relevant dynamical parameters for the subsystem of interest. Importantly, the algorithm we develop is constructed such that the learned generator implements a physically consistent open quantum time-evolution. We exploit this to learn the generator of the dynamics of a subsystem of a many-body system subject to a unitary quantum dynamics. We explore the capability of our method to recover the time-evolution of a two-body subsystem and exploit the physical consistency of the generator to make predictions on the stationary state of the subsystem dynamics.  © 2022 The Author(s). Published by IOP Publishing Ltd on behalf of the Institute of Physics and Deutsche Physikalische Gesellschaft.},
	author_keywords = {completely positive dynamics; interacting spins; Lindblad dynamics; machine learning},
	keywords = {Machine learning; Quantum optics; Spin dynamics; Completely positive; Completely positive dynamic; Interacting spin; Lindblad; Lindblad dynamic; Machine-learning; Many-body systems; Markovian quantum master equation; Quantum dynamics; Spin chains; Dynamics},
	correspondence_address = {F. Carnazza; Institut für Theoretische Physik, Center for Quantum Science, Universität Tübingen, Tübingen, Auf der Morgenstelle 14, 72076, Germany; email: francesco.carnazza@uni-tuebingen.de},
	publisher = {Institute of Physics},
