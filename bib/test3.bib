	keywords = {Computer aided design; Life cycle; Quantum chemistry; Quantum optics; Simulation platform; Timing circuits; Topology; Tunnel junctions; 'spice'; Electronics design automation; Josephson-junction; Majorana; Majoranum zero mode; Quantum Computing; Quantum system modeling; Quantum system modeling and simulation; Spin qubit; System modeling and simulation; Topological quantum computing; SPICE},
