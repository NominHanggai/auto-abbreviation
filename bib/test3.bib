@ARTICLE{Yang2022,
	author = {Yang, Yi-Jia and Liu, Yu-Qiang and Yu, Chang-Shui},
	title = {Heat transfer in transversely coupled qubits: optically controlled thermal modulator with common reservoirs},
	year = {2022},
