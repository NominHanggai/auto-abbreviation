	affiliations = {Institut für Theoretische Physik, Leibniz Universität Hannover, Appelstraße 2, Hannover, 30167, Germany; Zentrum für Optische Quantentechnologien, Institut für Laserphysik, Universität Hamburg, Hamburg, 22761, Germany},
